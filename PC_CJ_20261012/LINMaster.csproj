  <!-- ================================================================
       NativeOsp / OspBridge.dll 자동 빌드
       - 기존 cmake-build 폴더를 유지하여 Visual Studio/Ninja 파일 잠금 방지
       - cmake configure 후 증분 build
       ================================================================ -->
  <!-- Step 1: cmake-build 폴더가 없을 때만 생성 -->
  <Target Name="CleanCMakeBuildDir" BeforeTargets="ConfigureOspBridge" Condition="'$(SkipNativeOspBridge)' != 'true'">
    <MakeDir Directories="$(MSBuildProjectDirectory)\NativeOsp\cmake-build" Condition="!Exists('$(MSBuildProjectDirectory)\NativeOsp\cmake-build')" />
  </Target>
  <!-- Step 2: cmake configure (항상 실행) -->
  <Target Name="ConfigureOspBridge" BeforeTargets="BuildOspBridge" Condition="'$(SkipNativeOspBridge)' != 'true'">
    <Message Text="[NativeOsp] cmake configure..." Importance="high" />
    <Exec Command="set PATH=C:\mingw64\bin;%PATH% &amp;&amp; cmake --fresh -S &quot;$(MSBuildProjectDirectory)\NativeOsp&quot; -B &quot;$(MSBuildProjectDirectory)\NativeOsp\cmake-build&quot; -G Ninja -DCMAKE_C_COMPILER=&quot;C:\mingw64\bin\gcc.exe&quot; -DCMAKE_MAKE_PROGRAM=&quot;C:\iar\ewarm-9.70.4\common\bin\ninja.exe&quot;" WorkingDirectory="$(MSBuildProjectDirectory)\NativeOsp\cmake-build" />
  </Target>
  <!-- Step 3: cmake build -->
  <Target Name="BuildOspBridge" BeforeTargets="BeforeBuild" Condition="'$(SkipNativeOspBridge)' != 'true'">
    <Message Text="[NativeOsp] cmake build..." Importance="high" />
    <Exec Command="set PATH=C:\mingw64\bin;%PATH% &amp;&amp; cmake --build &quot;$(MSBuildProjectDirectory)\NativeOsp\cmake-build&quot;" WorkingDirectory="$(MSBuildProjectDirectory)\NativeOsp\cmake-build" />
  </Target>
  <!-- Step 4: OspBridge.dll → bin 출력 폴더로 복사 -->
  <Target Name="CopyOspBridge" AfterTargets="Build" Condition="'$(SkipNativeOspBridge)' != 'true' and Exists('$(MSBuildProjectDirectory)\NativeOsp\build\OspBridge.dll')">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\NativeOsp\build\OspBridge.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
